# Public homepage works without configuration. Google sign-in requires all six values.
# Copy to .env.local and enter secrets locally. Never commit .env.local.
DATABASE_URL=mongodb://localhost:27017/?replicaSet=rs0
DATABASE_NAME=make_my_marriage_dev
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Use a MongoDB replica set (or Atlas) for transactional account creation.
